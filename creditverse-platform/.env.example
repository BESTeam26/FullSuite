# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Project Settings → API). The anon key is safe for the browser;
# RLS policies govern what it can read. NEVER put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Auth mode:
#   live  - real Supabase auth (default when the two vars above are set)
#   demo  - no backend; boots a fake agency-owner session over seed data
#           (default when the Supabase vars are missing)
# VITE_AUTH_MODE=live

# Public site URL used for canonical links / auth redirects
VITE_SITE_URL=http://localhost:8080
